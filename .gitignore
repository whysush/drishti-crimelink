# ---- dependencies / builds / venvs ----
node_modules/
crimelink-app/build/
.venv*/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
*.egg-info/
*.log
.DS_Store

# ---- Catalyst local machine binding (regenerated by `catalyst` CLI) ----
.catalystrc

# ---- AppSail: the deploy installs pip packages INTO this dir (~290MB).
#      Ignore everything, then whitelist only our source. ----
/appsail-python/*
!/appsail-python/app.py
!/appsail-python/app-config.json
!/appsail-python/requirements.txt
!/appsail-python/run_local.py
!/appsail-python/README.md
!/appsail-python/.gitignore
!/appsail-python/engine/
!/appsail-python/data/

# ---- Functions: ignore any locally-installed deps, keep source ----
functions/crimelink_function/**/*.dist-info/
*.tsbuildinfo
